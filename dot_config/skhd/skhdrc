# MODES =======================================================================
:: default
:: resize @
# NEW TERMINAL ================================================================
cmd - return: /opt/homebrew/bin/kitty -1 --directory ~
# MANAGEMENT ==================================================================
cmd + shift - r: skhd --restart-service && aerospace reload-config
# FOCUS WINDOWS ===============================================================
cmd - k: aerospace focus up
cmd - l: aerospace focus right
cmd - j: aerospace focus down
cmd - h: aerospace focus left
# MOVE WINDOWS ================================================================
cmd + shift - k: aerospace move up
cmd + shift - l: aerospace move right
cmd + shift - j: aerospace move down
cmd + shift - h: aerospace move left
# FOCUS SPACES ================================================================
cmd - 1: aerospace workspace 1
cmd - 2: aerospace workspace 2
cmd - 3: aerospace workspace 3
cmd - 4: aerospace workspace 4
cmd - 5: aerospace workspace 5
cmd - 6: aerospace workspace 6
cmd - 7: aerospace workspace 7
cmd - 8: aerospace workspace 8
cmd - 9: aerospace workspace 9
cmd - 0: aerospace workspace 10
# MOVE WINDOW TO SPACE ========================================================
cmd + shift - 1: aerospace move-node-to-workspace 1
cmd + shift - 2: aerospace move-node-to-workspace 2
cmd + shift - 3: aerospace move-node-to-workspace 3
cmd + shift - 4: aerospace move-node-to-workspace 4
cmd + shift - 5: aerospace move-node-to-workspace 5
cmd + shift - 6: aerospace move-node-to-workspace 6
cmd + shift - 7: aerospace move-node-to-workspace 7
cmd + shift - 8: aerospace move-node-to-workspace 8
cmd + shift - 9: aerospace move-node-to-workspace 9
cmd + shift - 0: aerospace move-node-to-workspace 10
# FOCUS MONTIOR ===============================================================
cmd + shift - m: aerospace focus-monitor --wrap-around next
# MOVE WINDOW TO MONITOR ======================================================
cmd + shift - p: aerospace move-node-to-monitor --wrap-around prev
cmd + shift - n: aerospace move-node-to-monitor --wrap-around next
# Move workspace to monitor
cmd + shift - w: aerospace move-workspace-to-monitor next --wrap-around
# TOGGLE FULLSCREEN ===========================================================
cmd - f: aerospace fullscreen
